# GEMINI_API_KEY: Optional backend key (NEVER exposed to client).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for self-referential links & service workers
APP_URL="http://localhost:3000"

# Optional Backend Translation & TTS Proxies (No API keys in client code)
# If empty or not set, online translation/TTS steps are silently skipped.
VITE_TRANSLATION_PROXY_URL=""
VITE_TTS_PROXY_URL=""
